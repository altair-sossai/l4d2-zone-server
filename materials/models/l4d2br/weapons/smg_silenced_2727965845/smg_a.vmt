VertexLitGeneric
{
$baseTexture "models/l4d2br/weapons/smg_silenced_2727965845/smg_a"
$bumpmap "models/l4d2br/weapons/smg_silenced_2727965845/smg_a_normal"

$phong 1
$phongboost 4
$phongalbedoboost 60

$phongfresnelranges "[.8 .8 1]"
$phongexponenttexture "models/l4d2br/weapons/smg_silenced_2727965845/smg_a_exponent"
$nocompress 1
$basemapalphaphongmask 1
//$envmap env_cubemap
$envmapfresnel 1
$envmapFresnelMinMaxExp "[10 40 .4]"
$envmaptint 		"[.2 .2 .2]"

$phongalbedotint 1
$phongdisablehalflambert 1

$nocull 1

		//Glow
$selfillum 1
$selfillummask "models/l4d2br/weapons/smg_silenced_2727965845/glow1"
$selfillumtint ".2 .2 .2"

Proxies   
{
AnimatedTexture
{
animatedTextureVar $basetexture
animatedTextureFrameNumVar $frame
animatedTextureFrameRate 10
}
}
}







