VertexLitGeneric	//着色器类型 要透明则用LightMappedGeneric
{
	$basetexture	"models/l4d2br/weapons/shotgun_chrome_2814124024/v_shotgun_a"	
	$bumpmap	"models/l4d2br/weapons/shotgun_chrome_2814124024/v_shotgun_n"	
	
	$phong	"1"	//冯氏着色开启，使用法线的alpha贴图作为遮罩
	$phongboost	"1.2"	//数值越大反光越强烈 0.75~10
	$phongfresnelranges	"[0.21 0.6 0.85]"	//冯-菲涅尔参数，phong必须有它否则失效，第一项背对反光亮度，第三项面对反光亮度，第二项是中和。
	
	$phongalbedotint	"1"	//以basetexture作为反光色调参考，但优先级比phongtint低
	$phongalbedoboost	"2"	//增强反射颜色的亮度
	$phongexponent	"225"	//冯氏光照的密度（高光点的面积大小），数值越大，高光点越小
	$phongexponenttexture	"models/l4d2br/weapons/shotgun_chrome_2814124024/v_shotgun_a_exp"	

	
	$envmap	"env_cubemap"	//环境贴图参数，一般用env_cubemap代替地址，使用游戏里最近的环境贴图作为镜面反射
	$normalmapalphaenvmapmask	"1"	//使用法线贴图的alpha图层作为环境反射的遮罩，一般需要开启，不然武器表面成镜子了
	$envmaptint	"[.2 .2 .2]"	//若无光源但有环境，依然会有环境反射，可以调节颜色，一般默认白光即可
	$envmapfresnel	"1"	//在phongfresnelranges启用时生效，调节环境反射菲涅尔效果
	
	$rimlight	"1"	
	$rimlightexponent	"255"	
	$rimlightboost	"255"	
	
	$halflambert	"1"	

	$selfillum 1
	$selfillummask "models/l4d2br/weapons/shotgun_chrome_2814124024/v_shotgun_m"
	$selfillumtint "[.5 .5 .5]"
}