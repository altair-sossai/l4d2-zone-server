VertexLitGeneric
{
	$baseTexture                      "models/l4d2br/weapons/shotgun_chrome_2765785238/v_shotgun_a"
	$bumpmap                          "models/l4d2br/weapons/shotgun_chrome_2765785238/shcr_normal"
	$phongexponenttexture             "models/l4d2br/weapons/shotgun_chrome_2765785238/v_shotgun_a_exp"
	
	$phong 1
	$phongboost 4
	$phongalbedoboost 60
	$phongfresnelranges "[.8 .8 1]"
	
	$nocompress 1
	$basemapalphaphongmask 1
	
//$envmap env_cubemap
	$envmapfresnel 1
	$envmapFresnelMinMaxExp "[10 40 .4]"
	$envmaptint 		"[.2 .2 .2]"

	$phongalbedotint 1
	$phongdisablehalflambert 1

	$nocull 1

//Glow
	$selfillum 1
	$selfillummask "models/l4d2br/weapons/shotgun_chrome_2765785238/glow"
	$selfillumtint ".2 .2 .2"

	Proxies   
		{
			AnimatedTexture
		{
	animatedTextureVar $basetexture
	animatedTextureFrameNumVar $frame
	animatedTextureFrameRate 10
}
