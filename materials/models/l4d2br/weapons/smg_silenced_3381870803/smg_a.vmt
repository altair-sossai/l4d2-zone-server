VertexLitGeneric
{
$baseTexture "models/l4d2br/weapons/smg_silenced_3381870803/smg_a"
$bumpmap "models/l4d2br/weapons/smg_silenced_3381870803/smg_a_nrm"

$phongboost 175.0
$normalmapalphaenvmapmask 1
$phongexponent 10
$phongfresnelranges "[10 10 30]"
$BASEMAPLUMINANCEPHONGMASK 1
$color2 "[1.5 1.5 1.5]"
